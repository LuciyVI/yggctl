# Only test configuration, source and fixtures belong in the build context.
**
!Dockerfile
!.dockerignore
!requirements-dev.txt
!pyproject.toml
!yggctl/
!yggctl/**
!tests/
!tests/**
!tools/
!tools/docker_tests.py
!tools/fuzz_plateau.py

**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.hypothesis/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage*
**/.env
**/.env.*
